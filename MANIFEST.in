# Source-distribution contents.
#
# setup.py's find_packages(exclude=["tests*", ...]) governs the WHEEL only —
# the sdist is built from a separate file list, and setuptools' default sweep
# picked up tests/ (it is an importable package with an __init__.py). That put
# the whole suite inside the published tarball while the wheel had none of it,
# so the two artifacts of the same release disagreed about what the package
# contains.
#
# Ship the license and readme (twine renders the readme as the PyPI page),
# and nothing else that is not a package module.

include LICENSE
include README.md
include requirements.txt

prune tests
prune docs
prune examples
prune build
prune venv
prune .github

global-exclude *.py[cod]
global-exclude __pycache__
global-exclude .env*
global-exclude tmp*.txt
